# MoodMelo environment variables
# Copy this file to .env.local and update values as required.
# Never commit real secrets to source control.

# Application settings
VITE_APP_NAME=MoodMelo
VITE_APP_URL=http://localhost:5173

# YouTube embed settings
# Used as the allowed origin for YouTube iframe communication.
VITE_YOUTUBE_ORIGIN=http://localhost:5173

# Public backend URL for mood playlist metadata
VITE_API_BASE_URL=http://localhost:3000

# Optional external links
VITE_YOUTUBE_CHANNEL_URL=https://www.youtube.com/
VITE_INSTAGRAM_URL=https://www.instagram.com/
